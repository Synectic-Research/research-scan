# research-scan credentials.
#
# Copy to ~/.config/research-scan/.env (preferred — works from any directory once
# `uv tool install` has put the CLI on PATH), or to ./.env for repo-local dev.
#
# Precedence, highest first:  process environment  >  ~/.config/research-scan/.env  >  ./.env
#
# Only OPENALEX_API_KEY is mandatory (`research-scan doctor` exits 3 without it).

# Mandatory. Free key, ~$1/day free allowance: https://openalex.org/
OPENALEX_API_KEY=

# Strongly recommended: raises the OpenAlex rate limit to 5 req/s and puts you in
# the Crossref polite pool (sent in the User-Agent). Not a secret.
OPENALEX_MAILTO=

# Optional. Free key, 1 req/s: https://www.semanticscholar.org/product/api
# Without it, Semantic Scholar is throttled to ~0.3 req/s and doctor WARNs.
S2_API_KEY=

# Optional. Raises NCBI E-utilities from 3 req/s to 10 req/s. Only matters once the PubMed
# source is built — `biomed` routes to it today but it is recorded as unavailable.
NCBI_API_KEY=
